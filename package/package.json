{
  "name": "bmo-brain-client",
  "version": "0.1.0-rev.8",
  "description": "The brain service's client, generated from its OpenAPI document: every body as a type and a typed call for every route.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": ["index.ts", "openapi.d.ts"],
  "exports": {
    ".": "./index.ts",
    "./schema": "./openapi.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../docs/openapi.json --output openapi.d.ts",
    "check": "tsc --noEmit && bun test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
